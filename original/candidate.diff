+import type {CirculatoryItem,CirculatoryState} from '../api/circulatoryTypes';
+import {evidenceKey} from './evidenceIdentity';
+import {isReassessment,reassessmentReference} from './ReassessmentComparison';
+import {record,sourceTime,title,value,quality,words} from './evidencePresentation';
+import {RecordedDisclosure} from '../patient/CirculatoryEvidence';
+export interface HandoverSelection {item:CirculatoryItem;repository:string;cutoff:number}
+export function HandoverReview({selections,state,onRemove}:{selections:HandoverSelection[];state:CirculatoryState;onRemove:(key:string)=>void}){
+ return <section aria-label="Read-only handover"><h2>Handover review</h2><p>Selections for this page session only. Add exact sources or notes from the source inspector. This does not save, send or schedule a handover.</p><p>Recorded findings and clinician-authored assertions remain separate. No new derived result, diagnosis or treatment plan is generated.</p>
+ {!selections.length&&<p>No handover evidence selected. Open Patient and evidence, inspect a record, then choose Add exact source to handover.</p>}
+ {selections.map(({item,repository,cutoff})=>{const current=state.assembly.snapshot.items.find(i=>evidenceKey(i.fact)===evidenceKey(item.fact));const matches=repository===state.assembly.request.scope.repository_cutoff.repository_id&&current?.expected_digest===item.expected_digest;return <article key={repository+evidenceKey(item.fact)}><h3>{isReassessment(item)?'Clinician-authored reassessment (synthetic assertion)':'Recorded source evidence'} · {title(item)}</h3><p>{item.fact.kind} / {item.fact.id} / {item.fact.revision}</p><p>Source time: {sourceTime(item)} · Status: {String(item.fact.record_status)}</p><p>Source quality: {quality(item)} · Placement: {words(item.inclusion)}. Missing or unknown context is not confirmation.</p><p>Selected repository: {repository} · cutoff {cutoff} · ingestion {item.ingestion.ingestion_sequence}</p><p>{matches?'Exact selected revision is also present in this snapshot.':'Historical selection only: this exact revision/digest is not confirmed in the current snapshot. No successor substituted.'}</p>
+ {isReassessment(item)?<><p className="entry-note">{String(record(item.fact.description).raw_display??'Authored narrative not recorded')}</p>{(['baseline','intervention','followup'] as const).map(stage=>{const ref=reassessmentReference(item,stage);return <p key={stage}>{stage}: {ref?JSON.stringify(ref):'Missing, ambiguous or inconsistent reference; inspect complete retained note.'}</p>;})}</>:<p>Recorded result: {value(item).text} {value(item).unit}</p>}
+ <RecordedDisclosure label={'Handover source and uncertainty '+item.fact.id} value={{fact:item.fact,expected_digest:item.expected_digest,ingestion:item.ingestion,disclosures:item.disclosures}}/><button onClick={()=>onRemove(repository+evidenceKey(item.fact))}>Remove from handover selection</button></article>;})}</section>;
+}
