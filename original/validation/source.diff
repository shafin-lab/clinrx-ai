+ <div className="rf-scroll" role="region" aria-label="Recorded creatinine table" tabIndex={0}><table><thead><tr><th>Exact source</th><th>Recorded result / raw unit</th><th>Source timing</th><th>Uncertainty</th></tr></thead><tbody>{state.laboratory.observations.map(i=><tr key={JSON.stringify([i.fact.kind,i.fact.id,i.fact.revision])}><th><button onClick={event=>void inspect(i,true,event.currentTarget)}>{i.fact.id} / {i.fact.revision}</button></th><td>{renalValue(i)}</td><td>{i.fact.time.event??'Event time unavailable'} · {i.inclusion}<br/>Recorded {i.fact.time.recorded??'unavailable'}</td><td>Verification {i.fact.verification}; conflict {i.fact.conflict}; temporal status {i.fact.temporal_status}<br/>{i.fact.uncertainty.join(' · ')}</td></tr>)}</tbody></table></div>{state.laboratory.observations.length===0&&<p>No allowed creatinine observation is retained at this cutoff. Missing evidence is not normal kidney function.</p>}
