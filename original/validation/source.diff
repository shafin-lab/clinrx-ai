+import bundle from './renalFluidSchemas.json';
+import {validateTransportSchema,type Schema,object,scopeIdentity,factRef,requireRef,reject,instant} from './decoding';
+import {decodeCirculatoryState} from './circulatoryDecoders';
+import type {RenalFluidState,RenalHistory,RenalFluidContext,RenalObservation} from './renalFluidTypes';
+import type {ExactRef} from './circulatoryTypes';
+const schemas=bundle as unknown as {roots:Record<string,Schema>;definitions:Record<string,Schema>};
+export function equal(a:unknown,b:unknown):boolean {if(a===b)return true;if(Array.isArray(a)&&Array.isArray(b))return a.length===b.length&&a.every((v,n)=>equal(v,b[n]));if(a&&b&&typeof a==='object'&&typeof b==='object'){const x=object(a),y=object(b);return Object.keys(x).length===Object.keys(y).length&&Object.keys(x).every(k=>Object.hasOwn(y,k)&&equal(x[k],y[k]));}return false;}
+async function hash(text:string){return [...new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(text)))].map(x=>x.toString(16).padStart(2,'0')).join('');}
+async function canonical(text:string,model:unknown,digest:string){let parsed:unknown;try{parsed=JSON.parse(text);}catch{return reject();}if(!equal(parsed,model)||await hash(text)!==digest)reject();}
+async function observation(item:RenalObservation,scope:RenalFluidContext['scope']){const f=item.fact,m=item.ingestion,c=scope.repository_cutoff;scopeIdentity(f.binding.target,scope);if(f.kind!=='observation'||f.concept_id!=='synthetic-serum-creatinine'||m.repository_id!==c.repository_id||m.ingestion_sequence<1||m.ingestion_sequence>c.fact_watermark)reject();if((f.supersedes===null)!==(f.correction_reason===null))reject();if(f.supersedes&&(f.supersedes.kind!==f.kind||f.supersedes.id!==f.id||f.supersedes.version===f.revision))reject();if((f.value.status==='known')!==(f.value.value!==null))reject();let place='unplaced';if(f.time.event&&f.time.precision==='instant')place=instant(f.time.event)>=instant(scope.review_start)&&instant(f.time.event)<=instant(scope.review_end)?'in_window':'outside_window';if(item.inclusion!==place)reject();await canonical(item.canonical_fact,f,item.expected_digest);}
