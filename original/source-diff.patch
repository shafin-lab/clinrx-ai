+import type {CirculatoryItem} from '../api/circulatoryTypes';
+import {record} from './evidencePresentation';
+const quantity=(v:unknown)=>{const q=record(v);return q.value===undefined?'Not recorded':`${String(q.value)} ${String(record(q.unit).raw??'unit not recorded')} · mapping ${String(record(q.unit).status??'not recorded')}`;};
+export function EvidenceDraftSummary({fact}:{fact:CirculatoryItem['fact']}){
+ const occurred=record(fact.collected??fact.occurred),acquisition=record(fact.acquisition),gas=record(fact.blood_gas_context),action=record(fact.action),delivery=record(action.delivery??action.prescribed??action.prepared);
+ const rows:[string,string][]=[['Source time',String(occurred.source_timestamp??record(occurred.recorded).value??'Not recorded')],['Clock verification',String(occurred.clock??'unknown')],['Quality',String(record(acquisition.quality).status??'Not recorded')],['Method',String(acquisition.method??'Not recorded')],['Recorded production tag',String(fact.production??'Not applicable to this event')]];
+ if(fact.kind==='circulatory_oxygen'){rows.push(['Sample type',String(fact.sample_type)],['Specimen',String(record(fact.specimen).raw_display??'Not recorded')],['This sample’s FiO₂',quantity(gas.fio2)],['This sample’s PEEP',quantity(gas.peep)]);}
+ if(fact.kind==='circulatory_echo')rows.push(['Study / report / revision',[record(fact.study).raw_display,record(fact.report).raw_display,fact.report_revision].join(' / ')],['Source estimate basis',String(record(fact.calculation_method).raw_display??'Not recorded')]);
+ if(fact.kind==='circulatory_vasoactive')rows.push(['Agent / mapping',`${String(record(record(fact.drug).source).raw_display??'Not recorded')} · ${String(record(fact.drug).mapping??'unknown')}`],['Event',String(action.event_type)],['Source dose / rate',quantity(delivery.rate)],['Source concentration',quantity(delivery.concentration)],['Dosing weight basis',String(delivery.dosing_weight_basis??'unknown')]);
+ return <section aria-label="Proposed source context"><h4>Source context to review</h4><dl>{rows.map(([label,text])=><div key={label}><dt>{label}</dt><dd>{text}</dd></div>)}</dl>{fact.description!==undefined&&<p className="entry-note">{String(record(fact.description).raw_display)}</p>}<h4>Uncertainty and source caveats</h4>{[fact.uncertainty,fact.disclosures,record(acquisition.quality).limitations].flatMap(v=>Array.isArray(v)?v:[]).map((text,n)=><p key={n}>{String(text)}</p>)}<p>Unknown fields remain unknown. These are recorded source assertions and clinician-authored notes, not a generated diagnosis or treatment recommendation.</p></section>;
+}
