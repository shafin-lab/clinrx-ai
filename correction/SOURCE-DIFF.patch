+def test_colliding_identifiers_are_admitted_unchanged_and_remain_distinct(workspace):
+    client,db,body,*_=workspace
+    items=json.loads((Path(__file__).resolve().parents[1]/'frontend/tests/fixtures/reassessmentCollision.json').read_text())
+    before=rows(db)
+    for item in items:
+        command={'repository_id':body['repository_id'],'predecessor_digest':None,'fact':item['fact']}
+        preview=client.post(ENTRY+'/validate',json=command)
+        assert preview.status_code==200,preview.text
+        saved=client.post(ENTRY,json=command)
+        assert saved.status_code==200,saved.text
+        assert saved.json()['fact']==item['fact']
+        assert saved.json()['expected_digest']==item['expected_digest']
+        assert client.post(ENTRY+'/lookup',json=command).json()=={'status':'committed_match','evidence':saved.json()}
+    after=rows(db)
+    assert after['fact_revision'][:-4]==before['fact_revision']
+    assert len(after['fact_revision'])==len(before['fact_revision'])+4
+    for table in before:
+        if table not in ('fact_revision','sqlite_sequence'):assert after[table]==before[table]
