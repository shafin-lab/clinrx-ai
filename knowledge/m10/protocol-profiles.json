[
  {
    "id": "teg6s_trauma_reference",
    "label": "TEG 6s trauma — 2025 consensus reference",
    "version": "2026-10-23.1",
    "status": "reference_only",
    "population": "adult",
    "setting": "trauma",
    "device_profile_ids": [
      "teg6s_gh_lysis"
    ],
    "rules": [
      {
        "id": "plasma",
        "conditions": [
          {
            "assay": "CK",
            "parameter": "R",
            "op": "gt",
            "value": "10",
            "unit": "min"
          }
        ],
        "product": "plasma",
        "text": "Delayed clot initiation supports considering plasma after reviewing anticoagulants and the clinical/laboratory findings.",
        "source_ids": [
          "teg6s_trauma"
        ]
      },
      {
        "id": "fibrin",
        "conditions": [
          {
            "assay": "CFF",
            "parameter": "MA",
            "op": "lt",
            "value": "14",
            "unit": "mm"
          }
        ],
        "product": "fibrinogen_replacement",
        "text": "Fibrinogen replacement may be considered within this reference protocol; choose cryoprecipitate or the specified fibrinogen concentrate with the clinician and blood service.",
        "source_ids": [
          "teg6s_trauma"
        ]
      },
      {
        "id": "platelets",
        "conditions": [
          {
            "assay": "CRT",
            "parameter": "MA",
            "op": "lt",
            "value": "50",
            "unit": "mm"
          },
          {
            "assay": "CFF",
            "parameter": "MA",
            "op": "ge",
            "value": "14",
            "unit": "mm"
          }
        ],
        "product": "platelets",
        "text": "Reduced overall strength with adequate measured fibrin contribution supports reviewing platelet replacement in this reference protocol.",
        "source_ids": [
          "teg6s_trauma"
        ]
      },
      {
        "id": "lysis",
        "conditions": [
          {
            "assay": "CK",
            "parameter": "LY30",
            "op": "gt",
            "value": "2.6",
            "unit": "%"
          }
        ],
        "product": null,
        "text": "Increased measured clot breakdown. Review trauma antifibrinolytic timing and prior treatment; do not delay independently indicated trauma therapy while awaiting lysis.",
        "source_ids": [
          "teg6s_trauma"
        ]
      }
    ],
    "source_ids": [
      "teg6s_trauma"
    ],
    "reviewer_approval": null,
    "quantitative_dosing": "not_activated",
    "clinical_activation": "site_approval_required",
    "reassessment": "Reassess bleeding and repeat the relevant laboratory/VET measurements after intervention according to the selected local protocol.",
