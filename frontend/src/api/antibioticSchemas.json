              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "mg",
                "g",
                "IU"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "dose_detail": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dose Detail"
        },
        "route": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Route",
          "type": "string"
        },
        "schedule": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule"
        },
        "indication": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Indication",
          "type": "string"
        },
        "point": {
          "maxLength": 64,
          "minLength": 20,
          "title": "Point",
          "type": "string"
        },
        "actor": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "source_record": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Record",
          "type": "string"
        },
        "recorded_at": {
          "maxLength": 64,
          "minLength": 20,
          "title": "Recorded At",
          "type": "string"
        },
        "order": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
