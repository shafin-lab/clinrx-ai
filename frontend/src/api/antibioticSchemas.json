{
  "roots": {
    "AntibioticDraft": {
      "additionalProperties": false,
      "properties": {
        "dose_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/DoseReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dose_review_amendment": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dose Review Amendment"
        },
        "repository": {
          "format": "uuid",
          "title": "Repository",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
